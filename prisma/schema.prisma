model ECommerceStore {
  id             String  @id @default(cuid())
  userId         String
  platform       String  @default("shopify") // shopify | woocommerce | manual
  name           String
  slug           String
  description    String?
  storeUrl       String
  logo           String?
  currency       String  @default("INR")
  timezone       String  @default("Asia/Kolkata")
  isDefault      Boolean @default(false)
  accessToken    String?
  apiKey         String?
  apiSecret      String?
  webhookSecret  String?
  status         String  @default("connected")
  paymentOptions Json? // { card: true, upi: true, netbanking: true, cod: true }
  codMinAmount   Int? // Minimum amount for COD
  codMaxAmount   Int? // Maximum amount for COD

  // Shipping
  defaultShippingCost   Float?  @default(0) // Default shipping cost
  freeShippingThreshold Float? // Free shipping above this amount
  shippingMethod        String? @default("flat") // flat | calculated | free

  // Tax
  taxPercentage Float?  @default(0) // Tax percentage
  taxInclusive  Boolean @default(false) // Prices include tax

  // Order
  autoFulfillOrders     Boolean @default(false) // Auto-fulfill orders
  orderPrefix           String? @default("ORD") // Order number prefix
  sendConfirmationEmail Boolean @default(true) // Send order confirmation

  // Inventory
  trackInventory    Boolean @default(true) // Track inventory
  lowStockThreshold Int? // Low stock alert threshold

  // Checkout
  guestCheckout  Boolean @default(true) // Allow guest checkout
  requirePhone   Boolean @default(true) // Phone required
  requireAddress Boolean @default(true) // Address required

  // Notifications
  orderEmailAlerts Boolean @default(true) // Email alerts for new orders
  lowStockAlerts   Boolean @default(false) // Low stock email alerts

  // Sync
  syncInterval    Int? // Sync interval in minutes
  webhooksEnabled Boolean @default(true) // Webhooks enabled

  lastSyncAt     DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         ECommerceOrder[]
  products       ECommerceProduct[]
  abandonedCarts ECommerceAbandonedCart[]
  carts          ECommerceCart[]
  categories     Category[]
  configs        EcommerceConfig[]
  coupons        ECommerceCoupon[]

  @@index([userId])
  @@index([name])
  @@index([slug])
  @@index([apiKey])
}

model ECommerceCoupon {
  id             String         @id @default(cuid())
  storeId        String
  code           String
  type           String // "PERCENTAGE" or "FIXED"
  value          Float // e.g., 20 for 20% or 500 for ₹500 off
  minOrderAmount Float? // Minimum order amount to apply the coupon
  maxDiscount    Float? // Maximum discount amount (for percentage coupons)
  usageLimit     Int? // Total number of times this coupon can be used
  usedCount      Int            @default(0) // How many times it has been used
  expiryDate     DateTime? // When the coupon expires
  isActive       Boolean        @default(true)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
}

model ECommerceOrder {
  id                String         @id @default(cuid())
  storeId           String
  externalOrderId   String         @unique // Platform's Order ID
  orderNumber       String?
  totalAmount       Float
  currency          String         @default("INR")
  status            String
  financialStatus   String?
  fulfillmentStatus String?
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  trackingNumber    String?
  carrier           String?
  contactId         String? // Link to internal Contact if exists
  metadata          Json?
  userId            String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact           Contact?       @relation(fields: [contactId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@index([externalOrderId])
}

model ECommerceProduct {
  id                String                    @id @default(cuid())
  storeId           String?
  externalProductId String?                   @unique
  sku               String?                   @unique
  slug              String?                   @unique
  title             String
  description       String?
  price             Float
  discount          Float?                    @default(0)
  currency          String                    @default("INR")
  imageUrls         Json?
  status            String
  inventoryCount    Int?
  weight            Float?
  dimensions        Json?
  metadata          Json?
  userId            String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  store             ECommerceStore?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants          ECommerceProductVariant[]
  reviews           ECommerceReview[]

  @@index([storeId])
  @@index([userId])
  @@index([slug])
}

model ECommerceReview {
  id            String           @id @default(cuid())
  productId     String
  rating        Int // 1 to 5
  title         String?
  comment       String?
  customerName  String? // Display name
  customerEmail String?
  isVerified    Boolean          @default(false) // True if they bought it
  status        String           @default("pending") // pending, approved, rejected
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  product       ECommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([rating])
  @@index([status])
}

model ECommerceProductVariant {
  id             String           @id @default(cuid())
  productId      String
  name           String // e.g., "Small / Red"
  sku            String?
  price          Float? // If null, falls back to product price
  inventoryCount Int              @default(0)
  weight         Float?
  dimensions     Json?
  imageUrls      Json? // Variant-specific images
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  product        ECommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model ECommerceCart {
  id                 String         @id @default(cuid())
  storeId            String
  guestId            String? // Guest identifier (for logged out users)
  userId             String? // User ID (for logged in users)
  items              Json // Cart items array
  totalAmount        Float          @default(0)
  currency           String         @default("INR")
  status             String         @default("active") // active, converted, abandoned
  convertedToOrderId String? // If cart converted to order
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  store              ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, guestId])
  @@unique([storeId, userId])
  @@index([storeId])
  @@index([guestId])
  @@index([userId])
}

model ECommerceAbandonedCart {
  id             String         @id @default(cuid())
  storeId        String
  externalCartId String         @unique
  guestId        String? // Guest user identifier
  checkoutUrl    String?
  totalAmount    Float
  currency       String         @default("INR")
  customerEmail  String?
  customerPhone  String?
  recovered      Boolean        @default(false)
  lastReminderAt DateTime?
  reminderCount  Int            @default(0)
  metadata       Json?
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          ECommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@index([guestId])
}

model EmailAssignment {
  id           String   @id @default(cuid())
  workspaceId  String
  event        String // e.g., "USER_REGISTRATION", "USER_INVITATION"
  templateName String // e.g., "RegistrationMail.jsx"
  subject      String?
  fromEmail    String?
  isActive     Boolean  @default(true)
  content      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, event])
  @@index([workspaceId])
}

model AgentModel {
  id           String                 @id @default(cuid())
  workspaceId  String
  provider     String
  name         String
  label        String?
  apiKey       String
  description  String?
  healthStatus String                 @default("UNTESTED")
  latency      String?
  successRate  String?
  capability   String?
  strengths    String?
  bestFor      String?
  baseUrl      String?
  isDefault    Boolean                @default(false)
  isActive     Boolean                @default(true)
  metadata     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  AgentModelAssignment[]

  @@index([workspaceId])
  @@index([userId])
}

model AIAgent {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  role        String?
  type        String  @default("OpenClaw")
  status      String  @default("offline")
  description String?
  isMain      Boolean @default(false)

  // Hierarchy: Master -> Sub relationship
  parentId  String?
  parent    AIAgent?  @relation("AgentHierarchy", fields: [parentId], references: [id])
  subAgents AIAgent[] @relation("AgentHierarchy")

  // Model Fallback Logic
  strategy String                 @default("SEQUENTIAL") // SEQUENTIAL, PARALLEL
  models   AgentModelAssignment[]

  config    Json? // Additional task-specific configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model AgentModelAssignment {
  id       String     @id @default(cuid())
  agentId  String
  modelId  String
  priority Int        @default(0) // 0 = Primary, 1+ = Fallbacks
  agent    AIAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model    AgentModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([agentId, modelId])
  @@index([agentId])
  @@index([modelId])
}

model AgentConfig {
