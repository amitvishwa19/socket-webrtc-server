}

model KanbanActivity {
  id          String     @id @default(cuid())
  type        String
  description String
  taskId      String
  userId      String
  createdAt   DateTime   @default(now())
  task        KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Job {
  id           String           @id @default(cuid())
  title        String
  description  String
  department   String?
  location     String?
  type         String           @default("FULL_TIME")
  salaryRange  String?
  status       JobStatus        @default(DRAFT)
  requirements String[]         @default([])
  benefits     String[]         @default([])
  workspaceId  String
  userId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?

  @@index([workspaceId])
  @@index([status])
  @@index([categoryId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Candidate {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  phone        String?
  location     String?
  resumeUrl    String?
  avatarUrl    String?
  summary      String?
  skills       String[]         @default([])
  aiSummary    String?
  aiMatchScore Int?
  parsedData   Json?
  workspaceId  String
  userId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
  notes        AtsNote[]
  scorecards   Scorecard[]

  @@index([workspaceId])
  @@index([email])
}

model JobApplication {
  id           String      @id @default(cuid())
  jobId        String
  candidateId  String
  stage        String      @default("APPLIED")
  status       String      @default("ACTIVE")
  source       String?
  referredById String?
  resumeUrl    String?
  workspaceId  String
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  notes        AtsNote[]
  interviews   Interview[]
  offers       Offer[]
  scorecards   Scorecard[]

  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
  @@index([workspaceId])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  title         String
  startTime     DateTime
  endTime       DateTime
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  feedback      String?
  interviewers  String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Scorecard {
  id             String          @id @default(cuid())
  applicationId  String?
  candidateId    String
  interviewerId  String
  stage          String?
  score          Float?          @default(0)
  feedback       String?
  recommendation String?
  attributes     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer    User            @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
}

model AtsNote {
  id            String          @id @default(cuid())
  applicationId String?
  candidateId   String
  userId        String
  text          String
  isPrivate     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([candidateId])
  @@index([userId])
}

model Offer {
  id             String         @id @default(cuid())
  applicationId  String
  salary         String?
  startDate      DateTime?
  status         OfferStatus    @default(DRAFT)
  offerLetterUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Workflow {
  id                String              @id @default(cuid())
  name              String
  description       String?
  nodes             Json                @default("[]")
  edges             Json                @default("[]")
  workspaceId       String
  userId            String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  definition        Json?
  status            WorkflowStatus      @default(DRAFT)
  viewport          Json?
  isTemplate        Boolean             @default(false)
  scheduleCron      String?
  scheduleEnabled   Boolean             @default(false)
  webhookToken      String?
  failureWebhookUrl String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions        WorkflowExecution[]
  memories          WorkflowMemory[]

  @@index([workspaceId])
  @@index([userId])
}

model WorkflowExecution {
  id         String           @id @default(cuid())
  workflowId String
  status     String           @default("RUNNING")
  trigger    String           @default("manual")
  input      Json?
  output     Json?
  error      String?          @db.Text
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  logs       Json             @default("[]")
  edges      Json             @default("[]")
  nodes      Json             @default("[]")
  workflow   Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runLogs    WorkflowRunLog[]

  @@index([workflowId])
  @@index([status])
}

model WorkflowMemory {
  id         String   @id @default(cuid())
  workflowId String
  sessionId  String
  messages   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sessionId])
  @@index([workflowId])
}

model SystemCron {
  id             String           @id @default(cuid())
  name           String
  description    String?
  cronExpression String
  status         SystemCronStatus @default(ACTIVE)
  targetType     String           @default("FLOWBOT")
  targetId       String?
  payload        Json?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  workspaceId    String
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs           CronLog[]

  @@index([workspaceId])
  @@index([status])
  @@index([nextRunAt])
}

model CronLog {
  id           String      @id @default(cuid())
  cronId       String?
  jobName      String?     // Name or identifier: "Daily Sync", "Render Keepalive", "Vercel Cron", "WhatsApp Queue"
  source       String?     // Source: "RENDER", "VERCEL", "CRON_JOB_ORG", "GITHUB_ACTIONS", "INTERNAL", "WEBHOOK"
  endpoint     String?     // URL path: "/api/webhooks/cron", "/api/workspace/cron", etc.
  method       String      @default("GET")
  headers      Json?       // Request headers, authorization info, user-agent, etc.
  queryParams  Json?       // Query parameters (?key=val)
  payload      Json?       // Request JSON payload or body
  ipAddress    String?     // Client IP address
  userAgent    String?     // User agent
  status       String      @default("SUCCESS") // "RECEIVED", "RUNNING", "SUCCESS", "FAILED", "UNAUTHORIZED"
  statusCode   Int?        @default(200)
  response     Json?       // Execution result / response JSON
  errorMessage String?     @db.Text
  durationMs   Int?        // Execution time in milliseconds
  workspaceId  String?     // Associated Workspace ID
  triggeredAt  DateTime    @default(now())
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  systemCron   SystemCron? @relation(fields: [cronId], references: [id], onDelete: SetNull)

  @@index([cronId])
  @@index([jobName])
  @@index([source])
  @@index([status])
  @@index([workspaceId])
  @@index([createdAt])
}

