generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                   @id @default(cuid())
  uuid                      String?
  displayName               String?
  username                  String?                  @unique
  email                     String?                  @unique
  phone                     String?                  @unique
  avatar                    String?
  isVerified                Boolean                  @default(false)
  isActive                  Boolean                  @default(false)
  password                  String?
  uid                       String?
  provider                  String?
  role                      ROLE                     @default(GUEST)
  webDeviceToken            String?
  deviceToken               String?
  expoPushToken             String?
  refreshToken              String?
  accessToken               String?
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  lastActive                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  atsNotes                  AtsNote[]
  botFlows                  BotFlow[]
  campaigns                 Campaign[]
  channels                  Channel[]
  contacts                  Contact[]
  contactGroups             ContactGroup[]
  credentials               Credentials[]
  credit                    Credit?
  sharedDocuments           DocumentAccess[]         @relation("UserToDocumentAccess")
  jobs                      Job[]
  kanbanActivities          KanbanActivity[]
  kanbanColumns             KanbanColumn[]
  assignedTasks             KanbanTask[]             @relation("TaskAssignee")
  members                   Member[]
  messageTemplates          MessageTemplate[]
  profile                   Profile?
  scorecards                Scorecard[]
  servers                   Server[]
  setting                   Setting?
  systemCrons               SystemCron[]
  whatsAppAuths             WhatsAppAuth[]
  waMessages                WhatsAppMessage[]        @relation("UserWaMessages")
  sharedMessages            WhatsAppMessage[]        @relation("MessageUsers")
  workflows                 Workflow[]
  workspaceDocuments        WorkspaceDocument[]
  roles                     Role[]                   @relation("RoleToUser")
  ecommerceStores           ECommerceStore[]
  ecommerceOrders           ECommerceOrder[]
  ecommerceProducts         ECommerceProduct[]
  ecommerceAbandonedCarts   ECommerceAbandonedCart[]
  ecommerceCarts            ECommerceCart[]
  waJobs                    WhatsAppJob[]
  waDeliveryLogs            WhatsAppDeliveryLog[]
  agentModels               AgentModel[]
  aiAgents                  AIAgent[]
  agentConfigs              AgentConfig[]
  nodeCredentials           NodeCredential[]
  nodeSecrets               NodeSecret[]
  ragDocs                   RagDoc[]
  agentChatThreads          AgentChatThread[]
  agentChatMessages         AgentChatMessage[]
  whatsAppFlows             WhatsAppFlow[]
  templateShares            TemplateShare[]          @relation("SharedTemplateUser")
  sharedTemplates           MessageTemplate[]        @relation("TemplateUsers")
  contactShares             ContactShare[]
  conversationShares        ConversationShare[]      @relation("ConversationSharedWith")
  conversationSharesBy      ConversationShare[]      @relation("ConversationSharedBy")
  quotations                Quotation[]
  crmAccounts               Account[]
  crmDeals                  Deal[]                   @relation("DealOwner")
  crmActivities             CrmActivity[]

  @@index([email])
  @@index([phone])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  userId    String   @unique
  info      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id            String   @id @default(cuid())
  key           String   @unique
  general       Json?
  hospitalInfo  Json?
  locale        Json?
  social        Json?
  notifications Json?
  security      Json?
  integrations  Json?
  technical     Json?
  services      Json?
  staff         Json?
  privacy       Json?
  terms         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VisitorLog {
  id          String   @id @default(cuid())
  workspaceId String?
  sessionId   String?
  ipAddress   String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  country     String?
  countryCode String?
  city        String?
  region      String?
  latitude    Float?
  longitude   Float?
  path        String
  fullUrl     String?
  referrer    String?
  title       String?
  duration    Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([ipAddress])
  @@index([countryCode])
  @@index([path])
  @@index([createdAt])
}

model Server {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  imageUrl    String?
  inviteCode  String    @unique
  selected    Boolean   @default(false)
  type        String    @default("default")
  default     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channels    Channel[]
  members     Member[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      ChannelType @default(TEXT)
  userId    String
  serverId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([serverId])
}

model Member {
  id                     String          @id @default(cuid())
  role                   MemberRole      @default(PATIENT)
  userId                 String
  serverId               String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  conversationsInitiated Conversation[]  @relation("MemberOne")
  conversationsReceived  Conversation[]  @relation("MemberTwo")
  directMessages         DirectMessage[]
  server                 Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               Message[]

  @@index([userId])
  @@index([serverId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  fileUrl    String?
  memberId   String
  channelId  String
  deleted    Boolean  @default(false)
  sent       Boolean  @default(false)
  deleivered Boolean  @default(false)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([memberId])
}

model Conversation {
  id             String          @id @default(cuid())
  memberOneId    String
  memberTwoId    String
  memberOne      Member          @relation("MemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwo      Member          @relation("MemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)
  directMessages DirectMessage[]

  @@unique([memberOneId, memberTwoId])
  @@index([memberTwoId])
}

model DirectMessage {
  id             String       @id @default(cuid())
  content        String
  fileUrl        String?
  memberId       String
  conversationId String
  deleted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([conversationId])
}

model Role {
  id          String       @id @default(cuid())
  title       String       @unique
  slug        String?       @unique
  description String?
  color       String?
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")

  // Inheritance
  parentId String?
  parent   Role?   @relation("RoleInheritance", fields: [parentId], references: [id])
  children Role[]  @relation("RoleInheritance")
}

model Permission {
  id          String   @id @default(cuid())
  title       String
  slug        String?   @unique
  value       String   @unique
  color       String?  @default("#FFFF")
  description String
  category    String?
  type        String?  @default("ACTION")
  url         String?
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String?
  action      String?
  entityId    String?
  entityType  String?
  entityTitle String?
  userId      String?
  userImage   String?
  userName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String   @default("virtual")
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id              String              @id @default(cuid())
  name            String
  description     String?
  status          String              @default("DRAFT")
  messageType     String              @default("text")
  messageTemplate Json
  templateId      String?
  credentialId    String?
  scheduledAt     DateTime?
  userId          String
  platform        String              @default("WHATSAPP_CLOUD")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  template        MessageTemplate?    @relation(fields: [templateId], references: [id])
  credential      Credentials?        @relation(fields: [credentialId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@index([templateId])
  @@index([credentialId])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  phone      String
  status     String    @default("PENDING")
  errorLog   String?
  variables  Json?
  sentAt     DateTime?
  campaignId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model WhatsAppAuth {
  id              String                  @id @default(cuid())
  userId          String?
  status          WA_STATUS               @default(DISCONNECTED)
  sessionId       String                  @unique
  sessionName     String?
  deviceId        String?
  phoneNumber     String?
  deviceName      String?
  platform        String?
  qrCode          String?
  qrExpiresAt     DateTime?
  credentials     Json?
  connectedAt     DateTime?
  lastConnectedAt DateTime?
  disconnectedAt  DateTime?
  expiresAt       DateTime?
  isActive        Boolean                 @default(true)
  metadata        Json?
  updatedAt       DateTime                @updatedAt
  createdAt       DateTime                @default(now())
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            WhatsAppConnectionLog[]
  keys            WhatsAppSessionKey[]

  @@index([userId])
  @@index([phoneNumber])
}

model MessageTemplate {
  id            String          @id @default(cuid())
  templateId    String?
  userId        String
  name          String
  templateName  String?
  approved      Boolean         @default(false)
  category      String          @default("UTILITY")
  language      String          @default("en_US")
  type          String          @default("TEXT")
  body          String
  header        String?
  footer        String?
  buttons       Json?
  metadata      Json?
  status        String          @default("DRAFT")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isDefault     Boolean         @default(false)
  platform      String          @default("WHATSAPP_CLOUD")
  phoneNumberId String?
  campaigns     Campaign[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith    TemplateShare[]
  users         User[]          @relation("TemplateUsers")

  @@index([userId])
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  waId        String?  @unique
  userId      String
  jid         String
  text        String
  fromMe      Boolean
  timestamp   BigInt
  sharedUsers User[]   @relation("MessageUsers")
  status      String   @default("SENT")
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation("UserWaMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jid])
  @@index([createdAt])
}

model WhatsAppConnectionLog {
  id             String        @id @default(cuid())
  whatsappAuthId String?
  event          String
  previousStatus String?
  newStatus      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  whatsappAuth   WhatsAppAuth? @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@index([whatsappAuthId])
  @@index([createdAt])
}

model Contact {
  id              String           @id @default(cuid())
  workspaceId     String?          @default("cmnbhifag000458ikwhv1zso2")
  userId          String
  credentialId    String?
  title           String?
  name            String
  phone           String
  email           String?
  type            String?          @default("CONTACT") // CONTACT, CLIENT, LEAD
  platform        String?          @default("WHATSAPP")
  color           String?
  info            Json?
  category        String?
  tags            String[]         @default([])
  whatsappName    String?
  lastMessage     String?
  lastInteraction DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential      Credentials?     @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  groups          ContactGroup[]   @relation("ContactToGroup")
  ecommerceOrders ECommerceOrder[]
  address         String?
  location        Json?
  subscribed      Boolean          @default(true)
  verified        Boolean          @default(false)
  sharedWith      ContactShare[]
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deals           Deal[]
  crmActivities   CrmActivity[]
  candidateId     String?

  @@unique([workspaceId, credentialId, phone])
  @@index([userId])
  @@index([workspaceId])
  @@index([credentialId])
  @@index([phone])
  @@index([accountId])
}

model BotFlow {
  id          String         @id @default(cuid())
  name        String
  description String?
  userId      String
  workspaceId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  active      Boolean        @default(true)
  nodes       Json           @default("[]")
  edges       Json           @default("[]")
  steps       BotFlowStep[]
  executions  BotExecution[]

  @@index([userId])
}

model BotFlowStep {
  id        String   @id @default(cuid())
  botFlowId String
  type      String
  config    Json
  positionX Int
  positionY Int
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  botFlow   BotFlow  @relation(fields: [botFlowId], references: [id], onDelete: Cascade)

  @@index([botFlowId])
}

model BotExecution {
  id           String    @id @default(cuid())
  botFlowId    String?
  workspaceId  String
  phone        String
  message      String
  triggeredAt  DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  error        String?
  nodesVisited Json      @default("[]")
  responses    Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  botFlow      BotFlow?  @relation(fields: [botFlowId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([botFlowId])
  @@index([phone])
  @@index([status])
}

model WhatsAppSessionKey {
  id             String       @id @default(cuid())
  whatsappAuthId String
  keyId          String
  data           String
  whatsappAuth   WhatsAppAuth @relation(fields: [whatsappAuthId], references: [id], onDelete: Cascade)

  @@unique([whatsappAuthId, keyId])
  @@index([whatsappAuthId])
}

model WhatsAppJob {
  id          String                @id @default(cuid())
  userId      String
  type        String                @default("CAMPAIGN") // CAMPAIGN, TRANSACTIONAL, AUTOMATION
  platform    String                @default("WHATSAPP_CLOUD") // WHATSAPP_CLOUD, WHATSAPP_BUSINESS
  status      String                @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PAUSED
  payload     Json
  priority    Int                   @default(0)
  retryCount  Int                   @default(0)
  maxRetries  Int                   @default(3)
  errorLog    String?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  logs        WhatsAppDeliveryLog[]
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model WhatsAppDeliveryLog {
  id          String       @id @default(cuid())
  jobId       String?
  userId      String
  jid         String
  waId        String?      @unique
  status      String       @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  error       String?
  metadata    Json?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  job         WhatsAppJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId])
  @@index([jid])
  @@index([status])
}

model WhatsAppFlow {
  id                   String   @id @default(cuid())
  workspaceId          String
  userId               String
  name                 String
  description          String?
  flowId               String?  @unique
  status               String   @default("DRAFT")
  categories           String[] @default([])
  screens              Json     @default("[]")
  definition           Json?
  endpointUrl          String?
  metaValidationErrors Json?    @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model ContactGroup {
  id           String       @id @default(cuid())
  workspaceId  String?      @default("cmnbhifag000458ikwhv1zso2")
  userId       String
  credentialId String?
  name         String
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   Credentials? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  contacts     Contact[]    @relation("ContactToGroup")

  @@unique([workspaceId, credentialId, name])
  @@index([userId])
  @@index([workspaceId])
  @@index([credentialId])
}

model WorkspaceDocument {
  id          String              @id @default(cuid())
  name        String
  description String?
  fileUrl     String?
  fileKey     String?
  fileType    String?
  extension   String?
  fileSize    Int?
  category    String?             @default("GENERAL")
  content     String?             @db.Text
  isFolder    Boolean             @default(false)
  parentId    String?
  workspaceId String
  userId      String
  members     String[]            @default([])
  isStarred   Boolean             @default(false)
  status      String              @default("APPROVED")
  tags        String[]            @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  sharedWith  DocumentAccess[]
  parent      WorkspaceDocument?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    WorkspaceDocument[] @relation("FolderHierarchy")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([parentId])
}

model DocumentAccess {
  id         String            @id @default(cuid())
  documentId String
  userId     String
  role       String            @default("VIEWER")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  document   WorkspaceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User              @relation("UserToDocumentAccess", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model Category {
  id          String          @id @default(cuid())
  name        String
  slug        String
  description String?
  color       String?         @default("#3b82f6")
  type        String          @default("GENERAL")
  parentId    String?
  workspaceId String
  storeId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  parent      Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]      @relation("CategoryHierarchy")
  posts       Post[]
  jobs        Job[]
  store       ECommerceStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([parentId])
  @@index([storeId])
}

model Credentials {
  id          String     @id @default(cuid())
  platform    String
  profile     String?
  type        String?
  credentials Json?
  userId      String
  workspaceId String?
  expired     Boolean    @default(false)
  status      String     @default("disconnected")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  avatar      String?
  userInfo    Json?
  expiresAt   DateTime?
  environment String     @default("PROD")
  isDefault   Boolean    @default(false)
  verified    Boolean    @default(false)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  contacts    Contact[]
  groups       ContactGroup[]

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, isDefault])
}

model Post {
  id          String     @id @default(cuid())
  title       String?
  content     String
  mediaUrls   String[]   @default([])
  scheduledAt DateTime?
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
  errorLog    String?
  categoryId  String?
  tags        String[]   @default([])
  workspaceId String
  userId      String
  externalIds Json?
  platforms   String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  category    Category?  @relation(fields: [categoryId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model SystemLog {
  id          String   @id @default(cuid())
  workspaceId String?
  level       String?
  type        String?
  message     String?
  details     Json?
  userId      String?
  provider    String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([level])
  @@index([createdAt])
}

model KanbanColumn {
  id          String       @id @default(cuid())
  title       String
  order       Int          @default(0)
  workspaceId String
  userId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       KanbanTask[]
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model KanbanTask {
  id          String            @id @default(cuid())
  title       String
  type        String            @default("task")
  content     String?
  priority    String            @default("medium")
  dueDate     DateTime?
  order       Int               @default(0)
  columnId    String
  workspaceId String
  userId      String
  assigneeId  String?
  coverUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activities  KanbanActivity[]
  checklists  KanbanChecklist[]
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  column      KanbanColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@index([workspaceId])
  @@index([userId])
  @@index([assigneeId])
}

model KanbanChecklist {
  id        String     @id @default(cuid())
  title     String
  completed Boolean    @default(false)
  order     Int        @default(0)
  taskId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

