# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN=*

# WebRTC STUN/TURN Public Configuration (Default Google STUN)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# PostgreSQL Database URL for Prisma Client
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Internal Service Secret for Server-to-Server Event Broadcasting
INTERNAL_SERVICE_SECRET="devlomatix_internal_secret_key_2026"

# Universal JWT Encryption Key for Socket Authentication (matches Next.js ENCRYPTION_KEY)
ENCRYPTION_KEY="your_encryption_key_here"
